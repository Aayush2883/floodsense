# Server Configuration
PORT=4000
NODE_ENV=development

# AWS Configuration (Mumbai/Sydney)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
IOT_ENDPOINT=your_iot_endpoint_here.iot.ap-southeast-2.amazonaws.com

# S3 Buckets
S3_VOICE_BUCKET=floodsense-voice-reports-113410693577
S3_PHOTO_BUCKET=floodsense-flood-photos-113410693577

# AWS SNS & Location Service
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:113410693577:floodsense-alerts
PLACE_INDEX_NAME=floodsense-places

# DynamoDB Tables
DYNAMODB_TABLE_SENSORS=SensorReadings
DYNAMODB_TABLE_REPORTS=Reports
DYNAMODB_TABLE_ALERTS=Alerts
DYNAMODB_TABLE_USERS=Users
DYNAMODB_TABLE_REGIONS=RegionsIngested

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/floodsense?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_12345

# Neo4j AuraDB (Graph Routing)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
