# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real secrets.

PORT=4000

# ---- MongoDB Atlas ----
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/floodsense?retryWrites=true&w=majority

# ---- Neo4j AuraDB ----
# NOTE: on AuraDB the username and database name are BOTH the instance id
# (a random string like b6ba0848) — they are NOT "neo4j".
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=xxxxxxxx

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string

# ---- AWS ----
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=113410693577
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ---- Bedrock ----
# Sydney requires the "au." regional inference profile prefix.
# Do NOT add a ":0" version suffix — that returns "invalid model identifier".
# This key authenticates Bedrock ONLY, not DynamoDB/S3/Location.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
BEDROCK_TEXT_MODEL=au.anthropic.claude-opus-4-6-v1
BEDROCK_VISION_MODEL=au.amazon.nova-lite-v1

# ---- AWS Location Service ----
PLACE_INDEX_NAME=floodsense-places

# ---- S3 ----
S3_VOICE_BUCKET=floodsense-voice-reports-113410693577
S3_PHOTO_BUCKET=floodsense-flood-photos-113410693577

# ---- SNS ----
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:113410693577:floodsense-alerts

# ---- IoT Core ----
IOT_ENDPOINT=a37w3xlpofts9a-ats.iot.ap-southeast-2.amazonaws.com
IOT_TOPIC=floodsense/sensors/readings

# ---- DynamoDB tables ----
DDB_REPORTS=Reports
DDB_SENSOR_READINGS=SensorReadings
DDB_ALERTS=Alerts