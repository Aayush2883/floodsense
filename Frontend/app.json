{
  "expo": {
    "name": "FloodSense",
    "slug": "floodsense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.floodsense.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FloodSense uses your location to find a dry route to safety and to tag your flood reports.",
        "NSMicrophoneUsageDescription": "FloodSense uses the microphone for voice flood reports.",
        "NSCameraUsageDescription": "FloodSense uses the camera to attach a photo to a flood report."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5C66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.floodsense.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "FloodSense",
      "themeColor": "#0B5C66",
      "backgroundColor": "#F3F5F2"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
